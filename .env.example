# Example environment only. Copy to .env and set your own local values.
# No real secrets belong in this file or in the repository.

# Application
APP_ENV=development
APP_NAME=turnos-api
APP_VERSION=0.1.0
APP_URL=http://localhost:5173
LOG_LEVEL=INFO

# PostgreSQL: set these in .env (Compose interpolates them)
POSTGRES_PASSWORD=set-a-local-password
POSTGRES_APP_PASSWORD=set-another-local-password

# Backend runtime database (PostgreSQL 15+) — app role, subject to RLS
DATABASE_URL=postgresql+psycopg://turnos_app:set-another-local-password@localhost:5433/turnos
# Migrations/seed commands use the owner role (never the API runtime)
DATABASE_OWNER_URL=postgresql+psycopg://turnos_owner:set-a-local-password@localhost:5433/turnos

# Demo seed: password for admin@demo.test, recepcion@demo.test and odontologo@demo.test
# Choose your own value (minimum 8 characters). Never commit the real one.
DEMO_PASSWORD=set-a-demo-password

# Optional: point the first demo patient to a real phone (E.164) to test WhatsApp.
# Leave empty to keep the fictional +5491130551001.
DEMO_PHONE_RECIPIENT=

# WhatsApp (opcional; sin credenciales se usa el adaptador fake)
# WA_PROVIDER: fake | twilio | meta
WA_PROVIDER=fake
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v23.0

# Asynchronous processing
REDIS_URL=redis://localhost:6379/0

# Auth: replace with a real random value at least 32 bytes long.
JWT_SECRET=change-me-set-a-long-random-local-value

# Frontend (Vite reads VITE_* at build time)
VITE_API_BASE_URL=http://localhost:8000/api

# Placeholders reserved for later changes (not used in C-01)
# MP_ACCESS_TOKEN=
# WA_API_TOKEN=
# GCAL_CLIENT_ID=
# GCAL_CLIENT_SECRET=
# SENA_TTL_H=24
# CANCEL_ANTICIPACION_H=24

# C-06 reserva-online-publica: valores resueltos (ver docs/decisiones-oq.md)
# Los marcados "(provisional)" son recomendación pendiente de confirmar con el dueño.
PUBLIC_RATE_LIMIT_MAX=10              # tope de acciones públicas por ventana (por IP y por tenant)
PUBLIC_RATE_LIMIT_VENTANA_S=900       # ventana del rate-limit, en segundos (15 min)
PUBLIC_VERIFICACION_TTL_MIN=10        # TTL de la verificación liviana de un solo uso, en minutos
PUBLIC_DISPONIBILIDAD_HORIZONTE_D=30  # horizonte de disponibilidad pública, en días
PUBLIC_ANTISPAM_MODO=captcha          # modo anti-spam (provisional: captcha; alternativa otp)
RESERVA_TTL_H=48                      # ventana de reserva PENDIENTE en horas (provisional, ver OQ-1)

# C-07 lista-espera-auto-oferta: valor resuelto (default aprobado por el dueño, 2026-11-05)
OFERTA_TTL_MIN=120                    # expiración de la oferta de lista de espera, en minutos
