# Example environment only. Do not put real secrets here.
# Copy to .env for local development and replace placeholders as needed.

# Application
APP_ENV=development
APP_NAME=turnos-api
APP_VERSION=0.1.0
APP_URL=http://localhost:5173
LOG_LEVEL=INFO

# Backend runtime database (PostgreSQL 15+) — app role, subject to RLS
DATABASE_URL=postgresql+psycopg://turnos_app:dev-only-app-password@localhost:5433/turnos
# Migrations/seed commands use the owner role (never the API runtime)
DATABASE_OWNER_URL=postgresql+psycopg://turnos_owner:dev-only-owner-password@localhost:5433/turnos

# Asynchronous processing
REDIS_URL=redis://localhost:6379/0

# Auth: replace with a real random value at least 32 bytes long. Never commit production secrets.
JWT_SECRET=dev-only-jwt-not-for-production-change-this-1234567890

# Frontend (Vite reads VITE_* at build time)
VITE_API_BASE_URL=http://localhost:8000/api

# Placeholders reserved for later changes (not used in C-01)
# MP_ACCESS_TOKEN=
# WA_API_TOKEN=
# GCAL_CLIENT_ID=
# GCAL_CLIENT_SECRET=
# SENA_TTL_H=24
# CANCEL_ANTICIPACION_H=24

# C-06 reserva-online-publica: valores resueltos (ver docs/decisiones-oq.md)
# Los marcados "(provisional)" son recomendación pendiente de confirmar con el dueño.
PUBLIC_RATE_LIMIT_MAX=10              # tope de acciones públicas por ventana (por IP y por tenant)
PUBLIC_RATE_LIMIT_VENTANA_S=900       # ventana del rate-limit, en segundos (15 min)
PUBLIC_VERIFICACION_TTL_MIN=10        # TTL de la verificación liviana de un solo uso, en minutos
PUBLIC_DISPONIBILIDAD_HORIZONTE_D=30  # horizonte de disponibilidad pública, en días
PUBLIC_ANTISPAM_MODO=captcha          # modo anti-spam (provisional: captcha; alternativa otp)
RESERVA_TTL_H=48                      # ventana de reserva PENDIENTE en horas (provisional, ver OQ-1)
