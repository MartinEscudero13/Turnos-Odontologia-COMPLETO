    "@typescript-eslint/eslint-plugin": "8.16.0",
    "@typescript-eslint/parser": "8.16.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.16.0",
    "jsdom": "25.0.1",
    "playwright": "1.64.1",
    "typescript": "5.7.2",
